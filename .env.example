# Copy to .env (git-ignored) and fill in. Everything is optional.

# Unusual Whales API token (a UUID) — powers the 🐋 WHALES page.
# UNUSUAL_WHALES_API_KEY=… works too. You can also paste it in WHALES → Settings instead;
# a key saved there takes precedence.
UW_API_KEY=

# Requests to Unusual Whales are paced by the x-uw-req-per-minute-* headers UW returns.
# Optional extra local cap (requests/minute) and concurrency:
# UW_MAX_RPM=1000
# UW_MAX_CONCURRENT=6

# How long identical live requests are served from the local cache (ms).
# UW_CACHE_TTL_MS=10000

# Browser origins allowed to use the UW proxy (protects your quota from other websites).
# UW_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional Claude-powered AI assistant widget.
# ANTHROPIC_API_KEY=
